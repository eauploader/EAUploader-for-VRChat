<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xmlns:eau="EAUploader.UI.Components"
    xsi="http://www.w3.org/2001/XMLSchema-instance"
    engine="UnityEngine.UIElements"
    editor="UnityEditor.UIElements"
    noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
    editor-extension-mode="False"
>
    <ui:VisualElement class="flex-1 flex-col">

        <!-- Header : title on the left, actions on the right. Import is the filled primary action; the rest are outlined. -->
        <ui:VisualElement class="list-row list-row--header list-section">
            <ui:VisualElement class="list-row__group">
                <ui:Label text="Avatar List" class="text-xl font-bold list-title" />
                <eau:HelpButton msg-id="116" class="ml-2" />
            </ui:VisualElement>
            <ui:VisualElement class="list-row__group">
                <eau:ShadowButton name="open_import" class="button-with-icons mr-2">
                    <eau:MaterialIcon icon="download" />
                    <ui:Label text="Import" />
                </eau:ShadowButton>
                <eau:ShadowButton name="open_settings" class="button-with-icons button-outline mr-2">
                    <eau:MaterialIcon icon="settings" />
                    <ui:Label text="Settings" />
                </eau:ShadowButton>
                <eau:ShadowButton name="exit_unity" class="button-with-icons button-outline button-outline--danger">
                    <eau:MaterialIcon icon="logout" />
                    <ui:Label text="Exit Unity" />
                </eau:ShadowButton>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Toolbar : search and filters, closed off by a divider -->
        <ui:VisualElement class="list-section">
        <!-- Search : results update as you type, so there is no button. The field fills the row so both edges line up with the card grid -->
        <ui:VisualElement class="list-row">
            <ui:VisualElement class="search-field">
                <eau:TextFieldPro name="searchQuery" placeholder="Search by name or tag" class="flex-1" />
                <eau:MaterialIcon icon="search" picking-mode="Ignore" class="search-field__icon" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Filters : list controls on the left, display options on the right -->
        <ui:VisualElement class="list-row list-row--filters">
            <ui:VisualElement class="list-row__group">
                <ui:VisualElement name="categorybar" class="mr-2" style="width: 200px;" />
                <ui:VisualElement name="sortbar" class="mr-2" style="width: 200px;" />
                <eau:ShadowButton name="open_tag_filter" class="button-with-icons button-outline mr-2">
                    <eau:MaterialIcon icon="filter_alt" />
                    <ui:Label text="Filter by tag" />
                    <ui:Label name="tag_filter_count" class="ml-1 no-translate hidden" />
                </eau:ShadowButton>
                <eau:ShadowButton name="open_tag_settings" class="button-with-icons button-outline">
                    <eau:MaterialIcon icon="sell" />
                    <ui:Label text="Tag Settings" />
                </eau:ShadowButton>
            </ui:VisualElement>
            <ui:VisualElement class="list-row__group">
                <ui:Label text="Show hidden items" class="mr-2" />
                <eau:SlideToggle name="show_hidden" class="w-10 mr-4" />
                <!-- Small blocks on the left, one big block on the right: the slider reads as a card size control without a label -->
                <eau:MaterialIcon icon="apps" class="card-size-icon card-size-icon--small" />
                <ui:VisualElement name="card_size_bar" class="card-size-bar" />
                <eau:MaterialIcon icon="crop_square" class="card-size-icon card-size-icon--large" />
            </ui:VisualElement>
        </ui:VisualElement>
        </ui:VisualElement>

        <!-- Grid. The shadow sits last so it paints over the cards; it is shown once the grid is scrolled off the top. -->
        <ui:VisualElement class="list-scroll-area">
            <ui:ScrollView name="card_scroll" class="flex-1">
                <ui:VisualElement name="card_grid" class="avatar-grid list-grid" />
                <ui:Label name="empty_label" text="No items found." class="p-4 hidden" />
            </ui:ScrollView>
            <eau:Shadow name="list_scroll_shadow" shadow-blur="12" shadow-offset-y="2" shadow-opacity="0.18"
                picking-mode="Ignore" class="list-scroll-shadow hidden" />
        </ui:VisualElement>

        <!-- Drop area overlay -->
        <ui:VisualElement name="drop_model" class="drop-model hidden">
            <ui:Label name="drop_model_label" text="Drop files(.unitypackage, .prefab) to import" class="text-xl font-bold" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
